# Copie para supabase/functions/.env (nunca suba este arquivo). Lido pelo `npx supabase functions serve`.
# Na nuvem: npx supabase secrets set LASTFM_API_KEY=...
#
# Chave da API do Last.fm (aba Em alta). Crie em https://www.last.fm/api/account/create
LASTFM_API_KEY=
#
# Opcional: chave do song.link (links e capas nas outras plataformas no Descobrir). Sem ela,
# o limite é de ~10 pedidos por minuto. Peça em https://odesli.co (API).
SONGLINK_API_KEY=
