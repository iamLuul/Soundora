{
  "name": "soundhora",
  "private": true,
  "description": "Soundhora — rede social de música (Android, iOS e Web)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "app": "npm run start --workspace apps/mobile --",
    "versao": "node scripts/versao.mjs",
    "web:prod": "npm run web:prod --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:core && npm run test:app",
    "test:core": "npm run test --workspace packages/core",
    "test:app": "npm run test:ci --workspace apps/mobile",
    "test:db": "vitest run --config tests/db/vitest.config.mts",
    "lint": "npm run lint --workspace apps/mobile",
    "sync:shared": "node scripts/sync-shared.mjs",
    "demo": "node scripts/demo-data.mjs",
    "load": "node scripts/load-data.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check",
    "typecheck:functions": "node scripts/functions.mjs check",
    "test:functions": "node scripts/functions.mjs test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:web": "npm run test:web --workspace apps/mobile"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "deno": "^2.9.6",
    "patch-package": "^8.0.0",
    "pg": "^8.16.0",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
