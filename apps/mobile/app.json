{
  "expo": {
    "name": "Soundhora",
    "slug": "soundhora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soundhora",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.soundhora",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "spotify",
          "music",
          "deezer",
          "youtubemusic",
          "soundcloud",
          "tidal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3A374C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.soundhora"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Soundhora",
      "themeColor": "#3A374C",
      "backgroundColor": "#3A374C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A374C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Soundhora usa suas fotos e vídeos só quando você escolhe uma foto de perfil ou cria uma vibe.",
          "cameraPermission": "O Soundhora usa a câmera só quando você cria uma vibe.",
          "microphonePermission": "O Soundhora usa o microfone só para gravar o som dos vídeos das vibes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C62FF"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#3A374C"
  }
}
